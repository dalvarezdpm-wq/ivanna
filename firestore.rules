rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function member(fid) { return exists(/databases/$(db)/documents/families/$(fid)/members/$(request.auth.uid)); }
    function admin(fid) { return member(fid) && get(/databases/$(db)/documents/families/$(fid)/members/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && admin(request.resource.data.fid) && request.resource.data.exp is number;
      allow delete: if signedIn() && admin(resource.data.fid);
    }
    match /families/{fid} {
      allow read: if signedIn() && member(fid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if signedIn() && admin(fid);

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || member(fid));
        allow create: if signedIn() && request.auth.uid == uid && (
          (get(/databases/$(db)/documents/families/$(fid)).data.owner == request.auth.uid && request.resource.data.role == 'admin') ||
          (request.resource.data.role == 'member'
            && exists(/databases/$(db)/documents/invites/$(request.resource.data.code))
            && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.fid == fid
            && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.exp > request.time.toMillis()));
        allow update: if false;
        allow delete: if signedIn() && (admin(fid) || request.auth.uid == uid);
      }
      match /data/{docId} {
        allow read, write: if signedIn() && member(fid);
      }
      match /events/{eid} {
        allow read, delete: if signedIn() && member(fid);
        allow create, update: if signedIn() && member(fid)
          && request.resource.data.t is string && request.resource.data.ts is number;
      }
    }
  }
}
