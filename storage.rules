rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /families/{fid}/{allPaths=**} {
      function member() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/families/$(fid)/members/$(request.auth.uid));
      }
      allow read, delete: if member();
      allow create, update: if member()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
